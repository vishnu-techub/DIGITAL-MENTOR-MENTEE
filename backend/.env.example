# ============================================================
# KSRCE DIGITAL MENTOR-MENTEE MANAGEMENT SYSTEM
# Environment Configuration Template
# K.S.R. College of Engineering (Autonomous), Tiruchengode
# ============================================================

# Server Port
PORT=5050

# Runtime Environment (development | production | test)
NODE_ENV=development

# ------------------------------------------------------------
# TEMPORARY LOCAL FILE STORAGE
# Replace with a persistent database/storage implementation before
# production deployment.
#
# There is no database to connect to. MongoDB/Mongoose have been removed.
# Records are JSON files in backend/data/ (one file per collection) and
# uploaded files are on disk in backend/storage/uploads/.
#
# Data survives a normal process restart. It does NOT survive a redeploy or a
# change of host, because the filesystem is ephemeral. For a real deployment set
# the two variables below to a mounted persistent volume.
# ------------------------------------------------------------

# Directory holding the JSON collections. Defaults to backend/data/.
# DATA_DIR=/mnt/data/data

# Directory holding uploaded documents. Defaults to backend/storage/uploads/.
# UPLOADS_DIR=/mnt/data/uploads

# JWT Authentication Configuration
JWT_SECRET=your_secure_random_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Primary System Administrator Configuration (Override for production)
ADMIN_USERNAME=Ksrce@admin
ADMIN_EMAIL=admin@ksrce.ac.in
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_DEPT=IT

# Existing admin accounts are preserved on startup (the stored password is NOT
# overwritten). Set this to 'true' only to deliberately re-apply ADMIN_PASSWORD
# to the existing Administrator account on the next boot (one-shot recovery).
# ADMIN_FORCE_PASSWORD_RESET=false

# AI Assistant & Grammar Advisory API Key (Google Gemini / OpenAI compatible)
GEMINI_API_KEY=your_gemini_or_ai_api_key_here

# Client URL (for production CORS whitelist)
CLIENT_URL=http://localhost:5173