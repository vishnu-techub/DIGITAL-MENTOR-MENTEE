# ============================================================
# KSRCE DIGITAL MENTOR-MENTEE MANAGEMENT SYSTEM
# Environment Configuration
# K.S.R. College of Engineering (Autonomous), Tiruchengode
#
# TEMPORARY LOCAL FILE STORAGE.
# Replace with a persistent database/storage implementation before production
# deployment.
#
# There is no database connection string. MongoDB/Mongoose have been removed.
# Records are JSON files in backend/data/ and uploaded documents are files in
# backend/storage/uploads/. Set DATA_DIR / UPLOADS_DIR to a persistent volume if
# you deploy anywhere; otherwise a redeploy discards everything.
# ============================================================

# Server Port
PORT=5050

# Runtime Environment (development | production | test)
NODE_ENV=development

# Directory holding the JSON collections. Defaults to backend/data/.
# DATA_DIR=/mnt/data/data

# Directory holding uploaded documents. Defaults to backend/storage/uploads/.
# UPLOADS_DIR=/mnt/data/uploads

# JWT Authentication Secret
JWT_SECRET=ksrce_digital_mentoring_super_secret_jwt_key_2026_autonomous