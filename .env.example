# Server Port
PORT=5050

# Runtime Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ksrce_mentoring?retryWrites=true&w=majority
# Example for Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/ksrce_mentoring
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# JWT Authentication Secret
JWT_SECRET=ksrce_digital_mentoring_super_secret_jwt_key_2026_autonomous
